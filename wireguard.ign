{"ignition":{"version":"3.4.0"},"passwd":{"users":[{"name":"core","sshAuthorizedKeys":["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... \u003cYOUR_SSH_PUBLIC_KEY\u003e"]}]},"storage":{"directories":[{"path":"/opt/wireguard/config","mode":493}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=WireGuard VPN via Docker\nAfter=docker.service\nRequires=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=true\nExecStartPre=-/usr/bin/docker rm -f wireguard\nExecStart=/usr/bin/docker run -d \\\n  --name wireguard \\\n  --cap-add NET_ADMIN \\\n  --cap-add SYS_MODULE \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=UTC \\\n  -p 51820:51820/udp \\\n  -v /opt/wireguard/config:/config \\\n  --sysctl net.ipv4.conf.all.src_valid_mark=1 \\\n  --restart unless-stopped \\\n  lscr.io/linuxserver/wireguard:latest\nExecStop=/usr/bin/docker stop wireguard\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"wireguard.service"}]}}
